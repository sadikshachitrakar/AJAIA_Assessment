# Copy to .env and fill in. Never commit real values.

# Neon pooled connection (host contains "-pooler") — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection (same host without "-pooler") — used by prisma db push / migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-64-hex-characters"
